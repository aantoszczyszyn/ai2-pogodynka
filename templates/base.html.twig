<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Pogodynka{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<style>
    body {
        background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=50787");
    }
</style>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_location_index') }}">🌤 Pogodynka</a>
        <div class="navbar-nav">
            <a class="nav-link" href="{{ path('app_location_index') }}">Lokalizacje</a>
            <a class="nav-link" href="{{ path('app_measurement_index') }}">Pomiary</a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    {% block body %}{% endblock %}
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
